{
  "name": "glass-prison",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @smoked-glass/web",
    "build": "npm run build -w @smoked-glass/web",
    "typecheck": "tsc -p apps/web --noEmit && tsc -p packages/ui --noEmit",
    "tokens": "python3 packages/ui/tokens/build-css.py packages/ui/tokens/tokens.json > packages/ui/src/styles/tokens.css"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
